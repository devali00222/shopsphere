{
  "name": "shopsphere",
  "version": "0.1.0",
  "private": true,
  "description": "E-commerce backend: Postgres + MongoDB + Redis + BullMQ + AI-powered search",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.19.2",
    "zod": "^3.23.8",
    "dotenv": "^16.4.5",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2",
    "ioredis": "^5.4.1",
    "bullmq": "^5.12.0",
    "mongodb": "^6.8.0",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "express-rate-limit": "^7.4.0"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "tsx": "^4.16.5",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.15",
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/cors": "^2.8.17",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "prettier": "^3.3.3",
    "vitest": "^2.0.5",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "prisma": "^5.18.0",
    "@prisma/client": "^5.18.0",
    "pino-pretty": "^11.2.2"
  }
}
