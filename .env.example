NODE_ENV=development
PORT=3000

# Postgres (transactional data: users, products, orders, inventory)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shopsphere

# MongoDB (flexible data: reviews, activity logs)
MONGODB_URI=mongodb://localhost:27017/shopsphere

# Redis (cache, cart, BullMQ queues)
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
